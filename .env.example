# PostgreSQL
POSTGRES_DB=bankparser
POSTGRES_USER=bankparser_user
POSTGRES_PASSWORD=change_me_in_local_env

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_local_env
MINIO_BUCKET_STATEMENTS=bank-statements

# Spring Boot
SPRING_PROFILES_ACTIVE=dev

# Backend (lido por backend/src/main/resources/application.yml quando
# rodar fora do padrao localhost:5432 / localhost:9000)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_local_env

# Copie este arquivo para .env.local e ajuste os valores.
# .env.local NUNCA deve ser commitado (ja esta no .gitignore).
